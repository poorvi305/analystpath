{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "api/index.js": {
      "includeFiles": "mongo_data_store.json",
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/css/:path*",
      "destination": "/:path*"
    },
    {
      "source": "/js/:path*",
      "destination": "/:path*"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
